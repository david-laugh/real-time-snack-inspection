# C4 settings: copy these lines into the root .env for Docker Compose.
# Local Python: export them in the shell; this file is NOT auto-loaded.
C4_PORT=8003
C4_C2_STATS_URL=http://c2-preprocessing:8001/stats
C4_C2_STATS_TIMEOUT_S=1
C4_C2_STATS_INTERVAL_S=1
# For standalone UI testing without C2, use C4_C2_STATS_URL=

# Optional C1 counters for windowed end-to-end loss estimates (empty disables).
C4_C1_METRICS_URL=http://c1-gateway:8000/api/metrics

# Cookie tracking: scan line x as a fraction of image width (also movable by clicking the dashboard),
# travel direction (left|right), frames before/after the line used for the majority vote,
# and how long results wait to be processed in frame_id order.
C4_SCAN_LINE_RATIO=0.34
C4_TRAVEL_DIRECTION=left
C4_TRACK_VOTE_FRAMES=2
C4_TRACK_REORDER_S=0.5
