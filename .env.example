# Copy to .env and adjust. Do NOT commit .env.

# ---- Common ----
COMPOSE_PROJECT_NAME=pocket-smart-factory
SCHEMA_VERSION=1.0.0
LOG_LEVEL=INFO

# ---- MQTT (C1 -> C2 프레임 전달) ----
# .env는 compose 컨테이너에 주입되므로 브로커 서비스 이름을 쓴다.
# 컨테이너 밖(Windows에서 python 직접 실행)에서는 이 파일을 읽지 않고 코드 기본값 localhost를 쓴다.
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
# 호스트에 노출할 브로커 포트 (로컬 실행 서비스가 접속할 때 사용)
MQTT_HOST_PORT=1883
# C1 발행 {prefix}/frames/{session_id}, C2 구독 {prefix}/frames/+
MQTT_TOPIC_PREFIX=psf/v1

# ---- C1 Gateway ----
C1_PORT=8000
C1_TARGET_FPS=30
# C2로 보내는 방식: mqtt(기본) | http(예비) | echo(수신만)
C1_TRANSPORT=mqtt
# C1_TRANSPORT=http 일 때만 사용
C1_DOWNSTREAM=http://c2-preprocessing:8001/preprocess
# 폰 카메라는 HTTPS에서만 열림. cloudflared/ngrok 터널 주소를 넣으면 QR이 이 주소를 가리킴
C1_PUBLIC_URL=
# mqtt 기본: C1은 즉시 발행하고 드롭은 C2가 담당 (아래 두 값은 http 또는 C1_MQTT_ACK=1일 때만 사용)
# 실험용: C2가 {prefix}/acks로 ack를 보낼 때 C1이 흐름 제어 (0=끔, 1=켬)
C1_MQTT_ACK=0
# 동시에 처리 중일 프레임 수. "C3 복제 수 + 1" 권장 (C3 x1: 2, x2: 3, x3: 4)
C1_MAX_INFLIGHT=2
# 응답/ack 대기(초). 뒤쪽 타임아웃보다 길게 유지 (C1 5s > C2 /infer 3s > Nginx proxy_read)
C1_TIMEOUT=5
# 스트림 접속 토큰. auto면 실행 시 생성해 QR에 포함
C1_TOKEN=
# 상태 페이지에 링크할 C4 대시보드 주소
C1_DASHBOARD_URL=http://localhost:8003
# 프레임 이벤트 CSV (컨테이너 경로, host의 benchmark/results에 마운트됨)
C1_EVENT_LOG=/app/results/c1_events.csv

# ---- C2 Preprocessing ----
C2_PORT=8001
C2_RESIZE_WIDTH=1024
C2_RESIZE_HEIGHT=1024
# ROI format: x1,y1,x2,y2 (source pixel coords). Empty = full frame.
C2_ROI=

# ---- Nginx Inference LB ----
NGINX_LB_PORT=8080

# ---- C3 SAM2 Inference ----
C3_PORT=8002
# TODO(Member C): choose SAM2 variant (tiny / small / base_plus / large)
SAM2_MODEL_CFG=TODO
SAM2_CHECKPOINT_PATH=/app/models/TODO.pt
C3_DEVICE=cuda

# ---- C4 Visualizer ----
C4_PORT=8003
