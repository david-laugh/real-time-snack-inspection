# Copy to .env and adjust. Do NOT commit .env.

# ---- Common ----
COMPOSE_PROJECT_NAME=pocket-smart-factory
SCHEMA_VERSION=1.0.0
LOG_LEVEL=INFO

# ---- C1 Gateway ----
C1_PORT=8000
C1_TARGET_FPS=30
# C2 엔드포인트. 비우면 에코 모드(수신만). compose 기본값: http://c2-preprocessing:8001/preprocess
C1_DOWNSTREAM=http://c2-preprocessing:8001/preprocess
# 폰 카메라는 HTTPS에서만 열림. cloudflared/ngrok 터널 주소를 넣으면 QR이 이 주소를 가리킴
C1_PUBLIC_URL=
# C2로 동시에 보내는 요청 수. C2는 C3 결과까지 받은 뒤 응답하므로 이 값이 파이프라인 전체의
# 동시 처리 상한이 된다. 실험 구성에 맞춰 "C3 복제 수 + 1"로 설정 (C3 x1: 2, x2: 3, x3: 4)
C1_MAX_INFLIGHT=2
# C2 응답 대기(초). 뒤쪽 타임아웃보다 길게 유지 (C1 5s > C2 /infer 3s > Nginx proxy_read)
C1_TIMEOUT=5
# 스트림 접속 토큰. auto면 실행 시 생성해 QR에 포함
C1_TOKEN=
# 상태 페이지에 링크할 C4 대시보드 주소
C1_DASHBOARD_URL=http://localhost:8003
# 프레임 이벤트 CSV (컨테이너 경로, host의 benchmark/results에 마운트됨)
C1_EVENT_LOG=/app/results/c1_events.csv

# ---- C2 Preprocessing ----
C2_PORT=8001
C2_RESIZE_WIDTH=1024
C2_RESIZE_HEIGHT=1024
# ROI format: x1,y1,x2,y2 (source pixel coords). Empty = full frame.
C2_ROI=

# ---- Nginx Inference LB ----
NGINX_LB_PORT=8080

# ---- C3 SAM2 Inference ----
C3_PORT=8002
# TODO(Member C): choose SAM2 variant (tiny / small / base_plus / large)
SAM2_MODEL_CFG=TODO
SAM2_CHECKPOINT_PATH=/app/models/TODO.pt
C3_DEVICE=cuda

# ---- C4 Visualizer ----
C4_PORT=8003
