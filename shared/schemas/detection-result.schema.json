{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket-smart-factory/schemas/detection-result.schema.json",
  "title": "DetectionResult",
  "description": "C3 SAM2 Inference -> C4 Visualizer. Segmentation + defect decision per tracked object.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "session_id",
    "frame_id",
    "captured_at_ms",
    "inference_container_id",
    "inference_started_at_ms",
    "inference_finished_at_ms",
    "inference_latency_ms",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": ["1.0.0"]
    },
    "trace_id": {
      "type": "string",
      "description": "Propagated unchanged from ProcessedFrame."
    },
    "session_id": {
      "type": "string",
      "description": "Propagated unchanged from ProcessedFrame."
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Propagated unchanged from ProcessedFrame."
    },
    "captured_at_ms": {
      "type": "integer",
      "description": "Propagated unchanged from ProcessedFrame. Used by C4 for end-to-end latency."
    },
    "inference_container_id": {
      "type": "string",
      "description": "Which C3 replica produced this result (from env INFERENCE_CONTAINER_ID).",
      "examples": ["c3-inference-1"]
    },
    "inference_started_at_ms": {
      "type": "integer",
      "description": "Unix epoch milliseconds when C3 started inference."
    },
    "inference_finished_at_ms": {
      "type": "integer",
      "description": "Unix epoch milliseconds when C3 finished inference."
    },
    "inference_latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "inference_finished_at_ms - inference_started_at_ms (or a higher-resolution measurement)."
    },
    "detections": {
      "type": "array",
      "items": { "$ref": "#/$defs/detection" }
    },
    "preprocess_started_at_ms": {
      "type": "integer",
      "description": "Optional (1.1.0). Propagated unchanged from ProcessedFrame."
    },
    "preprocess_finished_at_ms": {
      "type": "integer",
      "description": "Optional (1.1.0). Propagated unchanged from ProcessedFrame."
    },
    "inference_received_at_ms": {
      "type": "integer",
      "description": "Optional (1.1.0). Unix epoch ms when C3 received the /infer HTTP request (before parsing / queueing)."
    },
    "latency_breakdown_ms": { "$ref": "#/$defs/latency_breakdown" },
    "inference_timings_ms": { "$ref": "#/$defs/inference_timings" }
  },
  "additionalProperties": false,
  "$defs": {
    "segment_ms": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Milliseconds; null if the end timestamp is earlier than the start (clock skew)."
    },
    "latency_breakdown": {
      "type": "object",
      "description": "Optional (1.1.0). Per-frame pipeline segments computed by C3 from the timestamps above.",
      "properties": {
        "capture_to_preprocess": { "$ref": "#/$defs/segment_ms", "description": "preprocess_started_at_ms - captured_at_ms: client upload + C1 + MQTT + C2 slot wait." },
        "preprocess": { "$ref": "#/$defs/segment_ms", "description": "preprocess_finished_at_ms - preprocess_started_at_ms: C2 processing." },
        "c2_to_c3": { "$ref": "#/$defs/segment_ms", "description": "inference_received_at_ms - preprocess_finished_at_ms: C2 forward -> Nginx -> C3." },
        "c3_queue": { "$ref": "#/$defs/segment_ms", "description": "Waiting for the replica's SAM2 predictor (queueing inside C3)." },
        "c3_service": { "$ref": "#/$defs/segment_ms", "description": "C3 processing excluding c3_queue." },
        "c3_total": { "$ref": "#/$defs/segment_ms", "description": "inference_finished_at_ms - inference_received_at_ms." },
        "capture_to_c3_done": { "$ref": "#/$defs/segment_ms", "description": "inference_finished_at_ms - captured_at_ms." }
      },
      "additionalProperties": false
    },
    "inference_timings": {
      "type": "object",
      "description": "Optional (1.1.0). C3 internal stage timings in ms (same values as the X-C3-*-Ms response headers).",
      "required": ["lock_wait", "decode", "encoder", "segmentation", "defect_analysis", "mask_encode", "total"],
      "properties": {
        "lock_wait": { "type": "number", "minimum": 0 },
        "decode": { "type": "number", "minimum": 0 },
        "encoder": { "type": "number", "minimum": 0 },
        "segmentation": { "type": "number", "minimum": 0 },
        "defect_analysis": { "type": "number", "minimum": 0 },
        "mask_encode": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "array",
      "description": "[x1, y1, x2, y2] in pixel coordinates of the preprocessed image.",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "mask": {
      "type": "object",
      "description": "Segmentation mask. TODO: finalize encoding.",
      "required": ["encoding", "data"],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": ["rle", "polygon", "png_b64"]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "data": {
          "description": "Encoded mask data. Shape depends on encoding (RLE counts / polygon points / base64 PNG)."
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "required": ["object_id", "bbox", "status", "defect_type", "defect_score", "mask"],
      "properties": {
        "object_id": {
          "type": "string",
          "description": "SAM2 tracking object id, stable across frames within a session."
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "status": {
          "type": "string",
          "enum": ["normal", "defect", "unknown"]
        },
        "defect_type": {
          "type": ["string", "null"],
          "description": "null when status != defect. TODO: finalize defect taxonomy (e.g. broken, crack, burnt, missing_part)."
        },
        "defect_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Defect confidence in [0, 1]."
        },
        "mask": {
          "oneOf": [
            { "$ref": "#/$defs/mask" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
